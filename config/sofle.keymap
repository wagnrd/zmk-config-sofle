#include "keys_de.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

#define QWERTZ 0
#define BASE 1
#define SPECIAL 2
#define CONTROL 3

&mt {
    tapping-term-ms = <200>;
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    behaviors {
        mmh: mod_morph_h {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp H>, <&kp LEFT>;

            mods = <(MOD_RALT)>;
        };

        mmj: mod_morph_j {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp J>, <&kp DOWN>;

            mods = <(MOD_RALT)>;
        };

        mmk: mod_morph_k {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp K>, <&kp UP>;

            mods = <(MOD_RALT)>;
        };

        mml: mod_morph_l {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp L>, <&kp RIGHT>;

            mods = <(MOD_RALT)>;
        };
    };

    combos { compatible = "zmk,combos"; };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Qwertz";
            bindings = <
&kp DE_CARET  &mt F1 DE_N1  &mt F2 DE_N2  &mt F3 DE_N3  &mt F4 DE_N4  &mt F5 DE_N5                            &mt F6 DE_N6  &mt F7 DE_N7  &mt F8 DE_N8  &mt F9 DE_N9  &mt F10 DE_N0  &mt F11 DE_SZ
&kp TAB       &kp Q         &kp W         &kp E         &kp R         &kp T                                   &kp DE_Y      &mt DE_UE U   &mt DE_AE I   &mt DE_OE O   &kp P          &mt F12 DE_PLUS
&kp ESC       &kp A         &kp S         &kp D         &kp F         &kp G                                   &kp H         &kp J         &kp K         &kp L         &kp DE_HASH    &kp DE_LT
&kp LSHFT     &kp DE_Z      &kp X         &kp C         &kp V         &kp B         &kp C_MUTE    &kp DELETE  &kp N         &kp M         &kp DE_COMMA  &kp DE_DOT    &kp DE_MINUS   &kp RSHFT
                            &kp LCTRL     &kp LALT      &kp LGUI      &kp BSPC      &mo 1         &kp RET     &kp SPACE     &none         &none         &tog 2
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>,
                <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        special_layer {
            bindings = <
&none  &none      &kp DE_SQUARE  &kp DE_CUBE  &none  &none                  &kp DE_ACUTE  &kp DE_LBRC      &kp DE_LBKT      &kp DE_RBKT      &kp DE_RBRC  &kp DE_BSLH
&none  &kp DE_AT  &none          &kp DE_EURO  &none  &none                  &none         &kp DE_U_UMLAUT  &kp DE_A_UMLAUT  &kp DE_O_UMLAUT  &none        &none
&none  &none      &none          &none        &none  &none                  &kp LEFT      &kp DOWN         &kp UP           &kp RIGHT        &none        &none
&none  &none      &none          &none        &none  &none  &none    &none  &none         &kp DE_MU        &none            &none            &none        &none
                  &none          &none        &none  &none  &none    &none  &none         &none            &none            &none
            >;

            label = "Special";
        };

        control_layer {
            display-name = "Control";
            bindings = <
&bootloader  &none  &none       &none       &none         &none                  &none  &none  &none  &none   &none  &bootloader
&none        &none  &none       &none       &none         &none                  &none  &none  &none  &none   &none  &none
&none        &none  &bt BT_CLR  &bt BT_PRV  &bt BT_NXT    &none                  &none  &none  &none  &none   &none  &none
&none        &none  &none       &none       &out OUT_TOG  &none  &none    &none  &none  &none  &none  &none   &none  &none
                    &none       &none       &none         &none  &none    &none  &none  &none  &none  &trans
            >;
        };
    };
};
